DATABASE_URL="postgresql://it_management:it_management_dev@localhost:5433/it_management?schema=public"
POSTGRES_DB=it_management
POSTGRES_USER=it_management
POSTGRES_PASSWORD=it_management_dev
API_PORT=3000
WHATSAPP_BOT_PORT=3001
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"

# SMTP reference: implicit TLS on port 465. Confirm alternatives with the mail administrator.
# Set SMTP_USER and SMTP_PASS only in local .env; never commit real credentials.
# Gmail SMTP uses a Google App Password; keep the regular account password out of this file.
SMTP_HOST=mail.gruponodos.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sistemas.envios@gruponodos.com
SMTP_PASS=
SMTP_FROM=sistemas.envios@gruponodos.com
OTP_ALLOWED_EMAILS=pasante.ti@gruponodos.com
